---
import TermCards from '#src/components/TermCards.astro';
import Base from '#src/layouts/Base.astro';
import { CATEGORIES } from '#src/lib/schema.ts';
import { facets, type TagFacet } from '#src/lib/tags.ts';
import { getTerms } from '#src/lib/terms.ts';
import { pageUrl } from '#src/lib/url.ts';

interface Props {
  facet: TagFacet;
}

export async function getStaticPaths() {
  const all = facets(await getTerms());
  return all.map((facet) => ({ params: { tag: facet.tag }, props: { facet } }));
}

const { facet } = Astro.props;
// A facet's whole point is the categories it reaches across, so it groups by them. A
// term-named facet is the exception that may reach across none of them (SPEC §2.5), and
// the heading still earns its place: it says which kind of thing the members all are.
const byCategory = CATEGORIES.map((category) => ({
  category,
  terms: facet.terms.filter((t) => t.data.category === category),
})).filter((group) => group.terms.length > 0);
---

<Base
  title={`${facet.label} · tag · vocab.design`}
  description={facet.blurb}
>
  <section class="pt-10 pb-10">
    <p class="text-sm text-muted italic">
      tag{facet.term && " · also a term"}
    </p>
    <h1 class="mt-1 font-serif text-4xl font-semibold tracking-tight">
      {facet.label}
    </h1>
    <p class="article mt-4 text-lg text-muted">{facet.blurb}</p>
    <p class="mt-3 text-sm text-muted">
      {facet.terms.length} terms across {byCategory.length}{" "}
      {byCategory.length === 1 ? "category" : "categories"} · <a
        href={`${pageUrl("/")}#by-tag`}
        class="text-accent underline underline-offset-3">all tags</a
      >
    </p>
    {
      facet.term && (
        <p class="article mt-6 rounded-lg border border-line bg-surface px-5 py-4 text-sm text-muted">
          <a
            href={pageUrl(facet.term.data.slug)}
            data-rel="facet-term"
            class="font-semibold text-accent underline underline-offset-3"
          >
            {facet.term.data.name}
          </a>{" "}
          is also a term in its own right. Its page carries the definition, a
          demo, and these same members grouped by how they relate to it.
        </p>
      )
    }
  </section>

  {
    byCategory.map(({ category, terms }) => (
      <section class="mb-12">
        <h2 class="mb-4 text-sm tracking-wide text-muted uppercase">
          {category}
        </h2>
        <TermCards terms={terms} />
      </section>
    ))
  }
</Base>
