---
import Base from '#src/layouts/Base.astro';
import { CATEGORIES } from '#src/lib/schema.ts';
import { facets, type TagFacet } from '#src/lib/tags.ts';
import { getTerms } from '#src/lib/terms.ts';
import { pageUrl } from '#src/lib/url.ts';

interface Props {
  facet: TagFacet;
}

export async function getStaticPaths() {
  const all = facets(await getTerms());
  return all.map((facet) => ({ params: { tag: facet.tag }, props: { facet } }));
}

const { facet } = Astro.props;
// A facet's whole point is the categories it reaches across, so it groups by them.
const byCategory = CATEGORIES.map((category) => ({
  category,
  terms: facet.terms.filter((t) => t.data.category === category),
})).filter((group) => group.terms.length > 0);
---

<Base
  title={`${facet.tag} · facet · vocab.design`}
  description={facet.blurb}
>
  <section class="pt-10 pb-10">
    <p class="text-sm text-muted italic">facet</p>
    <h1 class="mt-1 font-serif text-4xl font-semibold tracking-tight">
      {facet.tag}
    </h1>
    <p class="article mt-4 text-lg text-muted">{facet.blurb}</p>
    <p class="mt-3 text-sm text-muted">
      {facet.terms.length} terms across {byCategory.length} categories · <a
        href={pageUrl("/tags")}
        class="text-accent underline underline-offset-3">all facets</a
      >
    </p>
  </section>

  {
    byCategory.map(({ category, terms }) => (
      <section class="mb-12">
        <h2 class="mb-4 text-sm tracking-wide text-muted uppercase">
          {category}
        </h2>
        <ul class="grid gap-2">
          {terms.map((t) => (
            <li>
              <a
                href={pageUrl(t.data.slug)}
                class="group block rounded-lg border border-line bg-surface px-5 py-4 hover:border-accent"
              >
                <span class="font-serif text-lg font-semibold group-hover:text-accent">
                  {t.data.name}
                </span>
                <p class="mt-1 text-sm text-muted">{t.data.definition}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
