---
import Base from '#src/layouts/Base.astro';
import { byLetter, type GlossaryEntry, glossaryEntries, LETTERS, letterParam } from '#src/lib/glossary.ts';
import { getTerms } from '#src/lib/terms.ts';
import { pageUrl } from '#src/lib/url.ts';

interface Props {
  letter: string;
  entries: GlossaryEntry[];
  /** Every letter that has entries, so the reader can step sideways without going back. */
  siblings: { letter: string; param: string }[];
}

export async function getStaticPaths() {
  const groups = byLetter(glossaryEntries(await getTerms()));
  const stocked = LETTERS.filter((l) => (groups.get(l)?.length ?? 0) > 0);
  const siblings = stocked.map((letter) => ({ letter, param: letterParam(letter) }));
  return stocked.map((letter) => ({
    params: { letter: letterParam(letter) },
    props: { letter, entries: groups.get(letter) ?? [], siblings },
  }));
}

const { letter, entries, siblings } = Astro.props;
const heading = letter === '#' ? 'Other' : letter.toUpperCase();
const aliasCount = entries.filter((e) => e.canonical).length;
---

<Base
  title={`${heading} · glossary · vocab.design`}
  description={`${entries.length} names beginning with ${heading}: ${entries.length - aliasCount} terms and ${aliasCount} aliases.`}
>
  <section class="pt-10 pb-6">
    <p class="text-sm text-muted italic">glossary</p>
    <h1 class="mt-1 font-serif text-4xl font-semibold tracking-tight">
      {heading}
    </h1>
    <p class="mt-3 text-sm text-muted">
      {entries.length} names, {aliasCount} of them aliases · <a
        href={pageUrl("/glossary")}
        class="text-accent underline underline-offset-3">all letters</a
      >
    </p>
  </section>

  <nav aria-label="Letters" class="pb-8">
    <ul class="flex flex-wrap gap-1.5">
      {
        siblings.map((s) => (
          <li>
            <a
              href={pageUrl(`/glossary/${s.param}`)}
              aria-current={s.letter === letter ? "page" : undefined}
              class:list={[
                "inline-block rounded-md border px-2 py-0.5 text-sm uppercase",
                s.letter === letter
                  ? "border-accent text-ink"
                  : "border-line text-muted hover:text-ink",
              ]}
            >
              {s.letter}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <ul class="border-t border-line pb-12">
    {
      entries.map((e) => (
        <li class="border-b border-line">
          <a
            href={pageUrl(e.href)}
            class="group flex items-baseline justify-between gap-4 py-2.5"
          >
            <span>
              <span
                class:list={[
                  "group-hover:text-accent",
                  e.canonical ? "text-muted italic" : "font-serif font-semibold",
                ]}
              >
                {e.label}
              </span>
              {e.canonical && (
                <span class="ml-2 text-sm text-muted">
                  &rarr; {e.canonical.name}
                </span>
              )}
            </span>
            <span class="flex-none text-xs text-muted">{e.category}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
