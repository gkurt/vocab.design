---
import { render } from 'astro:content';
import SpecimenStage from '#src/components/SpecimenStage.astro';
import Base from '#src/layouts/Base.astro';
import { slugify } from '#src/lib/slug.ts';
import { derivedTags, familyOf } from '#src/lib/tags.ts';
import type { TermEntry } from '#src/lib/terms.ts';
import { getTerms } from '#src/lib/terms.ts';
import { absoluteUrl, pageUrl } from '#src/lib/url.ts';

interface Props {
  term: TermEntry;
  redirectFrom?: string;
}

export async function getStaticPaths() {
  const terms = await getTerms();
  return terms.flatMap((term) => [
    { params: { slug: term.data.slug }, props: { term } },
    // Every alias is a search query we answer (SPEC §10): thin redirect pages with canonical.
    ...term.data.aliases.map((alias) => ({
      params: { slug: slugify(alias.name) },
      props: { term, redirectFrom: alias.name },
    })),
  ]);
}

const { term, redirectFrom } = Astro.props;
const d = term.data;
const canonicalUrl = absoluteUrl(d.slug);

const all = await getTerms();
const bySlug = new Map(all.map((t) => [t.data.slug, t.data]));

// "Which word?" rows: this term plus every contrastWith neighbor that carries
// its own useWhen (SPEC §2.3). Neighbors without one stay in the Related list.
const contrastRows = d.useWhen
  ? d.relations.contrastWith.flatMap((s) => {
      const t = bySlug.get(s);
      return t?.useWhen ? [{ slug: s, name: t.name, useWhen: t.useWhen }] : [];
    })
  : [];
const tabled = new Set(contrastRows.map((row) => row.slug));

// Reverse listings for the directed relations are derived here, never stored (SPEC §2.3).
const reverse = (kind: 'variantOf' | 'partOf') =>
  all
    .filter((t) => t.data.relations[kind].includes(d.slug))
    .map((t) => t.data.slug)
    .sort();

/**
 * A term-named facet's members, grouped by the relation that joins them rather than by
 * category, which is what this page adds over `/tags/{tag}` (SPEC §2.5). Out of the index
 * for the reason Related is: seventeen member names on one page would make it compete for
 * each of them. Undefined for any term that does not name a facet.
 */
const family = familyOf(term, all);

// The facets this term is IN without declaring them, derived from its own relations.
const derived = derivedTags(term).map((tag) => ({ tag, name: bySlug.get(tag)?.name ?? tag }));

// The listing below states these edges in full, so the rail would say them a second time.
const claimed = new Set(family?.groups.map((group) => group.label) ?? []);

const relationGroups = [
  {
    label: 'Contrast with',
    kind: 'contrast',
    slugs: d.relations.contrastWith.filter((s) => !tabled.has(s)),
  },
  { label: 'Variant of', kind: 'variant-of', slugs: d.relations.variantOf },
  { label: 'Variants', kind: 'variants', slugs: reverse('variantOf') },
  { label: 'Part of', kind: 'part-of', slugs: d.relations.partOf },
  { label: 'Contains', kind: 'contains', slugs: reverse('partOf') },
  { label: 'See also', kind: 'see-also', slugs: d.relations.seeAlso },
].filter((group) => group.slugs.length > 0 && !claimed.has(group.label));

// The alias a reader typed cannot be read off the page they land on, so the redirect
// hands it over (src/components/analytics.ts). Only when there is somewhere to report it.
const measuring = Boolean(import.meta.env.PUBLIC_GA_ID);

/**
 * The share image (SPEC §10): this term's own specimen, photographed in identify's
 * pose. A term with no demo hands over nothing and the layout falls back to the site
 * card, which is the honest picture of a page with no specimen on it.
 */
const share =
  d.demo === 'none'
    ? undefined
    : {
        image: `/og/${d.slug}.png`,
        alt: `The vocab.design demo for ${d.name.toLowerCase()}, with the term itself picked out of the demonstration.`,
      };

/** Absolute, because a crawler resolves neither a relative image nor a protocol-relative one. */
const shareImageUrl = absoluteUrl(share?.image ?? '/og/site.png');

const { Content } = await render(term.entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: d.name,
  alternateName: d.aliases.map((a) => a.name),
  description: d.definition,
  keywords: d.tags,
  url: canonicalUrl,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'vocab.design',
    url: absoluteUrl('/'),
  },
};

/**
 * The trail a result shows instead of the raw URL. It says what the page already says
 * out loud: this word is one of the {category} words, and the category page is one click
 * up. Nothing deeper exists, because a term is two levels down and no more.
 */
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'vocab.design', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: d.category, item: absoluteUrl(`/browse/${d.category}`) },
    { '@type': 'ListItem', position: 3, name: d.name, item: canonicalUrl },
  ],
};

/**
 * Google shows roughly 60 characters and rewrites a title it cannot fit, so this spends
 * the room on the headword and the category and buys ONE alias with whatever is left.
 * Listing all of them ran to about 100 characters and bought nothing: the aliases are in
 * the "also called" line, in `alternateName`, and in the article, which is where an alias
 * query matches from in the first place.
 */
const TITLE_ROOM = 60;
const plain = `${d.name} · ${d.category} · vocab.design`;
const first = d.aliases[0]?.name;
const withAlias = first ? `${d.name} (${first}) · ${d.category} · vocab.design` : plain;
const title = withAlias.length <= TITLE_ROOM ? withAlias : plain;
---

{
  redirectFrom ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <title>
          {redirectFrom} → {d.name} · vocab.design
        </title>
        <link rel="canonical" href={canonicalUrl} />
        {/* An alias is what a reader reaches for and therefore what they paste, and no
            preview crawler follows a client-side meta refresh. Without these, sharing
            /snackbar produces a bare link where sharing /toast produces the specimen.
            Every value is the TERM's, `og:url` included, so a share of any of the 3,888
            alias URLs is attributed to the one page it redirects to. */}
        <meta property="og:type" content="article" />
        <meta property="og:site_name" content="vocab.design" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={d.definition} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={shareImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={share?.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        {measuring && (
          <script define:vars={{ handoff: `${redirectFrom}\n${d.slug}` }}>
            try {
              sessionStorage.setItem("vd:alias", handoff);
            } catch (error) {}
          </script>
        )}
        <meta http-equiv="refresh" content={`0; url=${pageUrl(d.slug)}`} />
      </head>
      <body>
        <p>
          “{redirectFrom}” is another name for{" "}
          <a href={pageUrl(d.slug)}>{d.name}</a>.
        </p>
      </body>
    </html>
  ) : (
    <Base
      title={title}
      description={d.definition}
      category={d.category}
      image={share?.image}
      imageAlt={share?.alt}
    >
      <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
      <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbs)}
      />
      {/* The agent-facing twin of this page (SPEC §10). A static host cannot answer
          `Accept: text/markdown` on this URL, so the markdown is a URL of its own and
          this is what makes it findable from the page rather than only from llms.txt. */}
      <link
        slot="head"
        rel="alternate"
        type="text/markdown"
        href={pageUrl(`/${d.slug}.md`)}
        title={`${d.name} as markdown`}
      />
      {/* `data-pagefind-filter` is what lets the search narrow to a category or a facet
          without a second index. The category sits on the article; each facet rides the
          chip that already names it, because an explicit value ignores the element's own
          text and repeated keys aggregate, so the chips ARE the tag filter. */}
      <article
        data-term={d.slug}
        data-pagefind-body
        data-pagefind-meta={`category:${d.category}`}
        data-pagefind-filter={`category:${d.category}`}
      >
        {/* The block a listing card grows into (SPEC §3). The card is a bordered
            surface holding a picture, a headword and a definition; here those three are
            named separately and fly to their own places, so what is left for this box to
            do is be the SURFACE: it takes the card's ground and spreads it out into the
            page's. Its own paint is paper, which is what the page is made of, so the
            morph ends on the real thing rather than on a panel drawn to look like it. */}
        <div class="vd-solid bg-paper" transition:name={`term-card-${d.slug}`}>
          <p class="text-sm text-muted italic">
            <a
              href={pageUrl(`/browse/${d.category}`)}
              class="hover:text-ink"
              data-rel="category"
            >
              {d.category}
            </a>
            {derived.map(({ tag, name }) => (
              <>
                {" · "}
                <a
                  href={pageUrl(`/tags/${tag}`)}
                  class="not-italic hover:text-ink"
                  data-pagefind-filter={`tag:${tag}`}
                >
                  {name.toLowerCase()}
                </a>
              </>
            ))}
            {d.tags.map((tag) => (
              <>
                {" · "}
                <a
                  href={pageUrl(`/tags/${tag}`)}
                  class="not-italic hover:text-ink"
                  data-pagefind-filter={`tag:${tag}`}
                >
                  {tag}
                </a>
              </>
            ))}
          </p>
          {/* Named for the morph in from a listing card (SPEC §3): the card's headword
              and its picture animate into these two. Every name here carries the SLUG, so
              a name only ever matches its own term: a card grows into the page it names,
              while two different terms share no name at all and so have nothing to
              interpolate, which is what stops one headword from being morphed into
              another word entirely on the way between two entries. */}
          {/* `w-fit` is about the morph rather than the layout: the box is what interpolates,
              and a headline that fills the column is a box eight times wider than the word
              in it, so the card's line is stretched across the whole measure on the way in.
              Shrunk to its own text, both sides are the word's own shape and the move is
              very nearly a plain scale. It changes nothing at rest, since the type is set
              from the left and wraps against the column either way. */}
          <h1
            class="mt-1 w-fit font-serif text-5xl font-semibold tracking-tight"
            data-pagefind-weight="10"
            transition:name={`term-headword-${d.slug}`}
          >
            {d.name}
          </h1>
          {d.aliases.length > 0 && (
            <p class="mt-3 text-sm text-muted" data-pagefind-weight="8">
              also called{" "}
              {d.aliases.map((a, i) => (
                <>
                  {i > 0 && ", "}
                  <span class="text-ink italic">{a.name}</span>
                  {a.source && (
                    <span data-pagefind-ignore>
                      {" "}({bySlug.get(a.source)?.name ?? a.source})
                    </span>
                  )}
                </>
              ))}
            </p>
          )}
          <p
            class="article mt-6 text-xl"
            data-pagefind-weight="6"
            transition:name={`term-definition-${d.slug}`}
          >
            {d.definition}
          </p>

          {d.status === "stub" && (
            <p class="mt-6 rounded-lg border border-line bg-surface px-4 py-3 text-sm text-muted">
              This entry is in progress. The full article and demo are
              still to come.
            </p>
          )}

          {d.demo !== "none" && (
            <div class="vd-solid mt-8" data-pagefind-ignore transition:name={`term-specimen-${d.slug}`}>
              <SpecimenStage slug={d.slug} name={d.name} isolation={d.demo} />
            </div>
          )}
        </div>

        <div class="article mt-8">
          <Content />
        </div>

        {d.useWhen && (
          <section class="mt-10">
            <h2 class="text-sm tracking-wide text-muted uppercase">
              Which word?
            </h2>
            <table class="mt-3 w-full text-sm">
              <thead>
                <tr class="text-left text-muted">
                  <th class="py-1 pr-4 font-normal">If you want</th>
                  <th class="py-1 font-normal">say</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-t border-line" data-pagefind-weight="6">
                  <td class="py-2 pr-4">{d.useWhen}</td>
                  <td class="py-2 font-semibold">{d.name.toLowerCase()}</td>
                </tr>
                {contrastRows.map((row) => (
                  <tr class="border-t border-line" data-pagefind-ignore>
                    <td class="py-2 pr-4">{row.useWhen}</td>
                    <td class="py-2">
                      <a
                        href={pageUrl(row.slug)}
                        data-rel="which-word"
                        class="text-accent underline underline-offset-3"
                      >
                        {row.name.toLowerCase()}
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )}

        {family && family.members.length > 0 && (
          <section class="mt-10" data-pagefind-ignore>
            <h2 class="text-sm tracking-wide text-muted uppercase">Family</h2>
            <p class="mt-1 text-sm text-muted">
              {family.members.length} terms belong to {d.name.toLowerCase()} ·{" "}
              <a
                href={pageUrl(`/tags/${family.tag}`)}
                class="text-accent underline underline-offset-3"
              >
                see them grouped by category
              </a>
            </p>
            {family.groups.map(({ label, terms }) => (
              <section class="mt-6">
                <h3 class="mb-3 text-sm tracking-wide text-muted uppercase">
                  {label}
                </h3>
                <ul class="grid gap-2">
                  {terms.map((t) => (
                    <li>
                      <a
                        href={pageUrl(t.data.slug)}
                        data-rel="family"
                        class="group block rounded-lg border border-line bg-surface px-5 py-4 hover:border-accent"
                      >
                        <span class="font-serif text-lg font-semibold group-hover:text-accent">
                          {t.data.name}
                        </span>
                        <p class="mt-1 text-sm text-muted">{t.data.definition}</p>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </section>
        )}

        {relationGroups.length > 0 && (
          <section class="mt-10" data-pagefind-ignore>
            <h2 class="text-sm tracking-wide text-muted uppercase">Related</h2>
            {relationGroups.map((group) => (
              <p class="mt-2 text-sm">
                <span class="text-muted">{group.label}: </span>
                {group.slugs.map((s, i) => (
                  <>
                    {i > 0 && " · "}
                    <a
                      href={pageUrl(s)}
                      data-rel={group.kind}
                      class="text-accent underline underline-offset-3"
                    >
                      {bySlug.get(s)?.name ?? s}
                    </a>
                  </>
                ))}
              </p>
            ))}
          </section>
        )}

        {d.implementations.length > 0 && (
          <section class="mt-10">
            <h2 class="text-sm tracking-wide text-muted uppercase">
              Implementations
            </h2>
            <p class="mt-1 text-sm text-muted">
              The demo above shows the idea. To build it, start with one of
              these.
            </p>
            <table class="mt-3 w-full text-sm">
              <tbody>
                {d.implementations.map((impl) => (
                  <tr class="border-t border-line">
                    <td class="py-2 pr-4 text-muted">{impl.system}</td>
                    <td class="py-2">
                      <a
                        href={impl.url}
                        class="text-accent underline underline-offset-3"
                        rel="noopener"
                      >
                        {impl.name}
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )}

        {d.sources.length > 0 && (
          <section class="mt-10">
            <h2 class="text-sm tracking-wide text-muted uppercase">Sources</h2>
            <ul class="mt-2 text-sm">
              {d.sources.map((source) => (
                <li>
                  <a
                    href={source.url}
                    class="text-accent underline underline-offset-3"
                    rel="noopener"
                  >
                    {source.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>

      {/* The other end of the card morph (SPEC §3). A term page is where the return trip
          starts, so the module has to be here as well as on the listings: a reader who
          arrived from a search engine and then follows the category link should get the
          same move as one who came in from a card. */}
      <script>
        import "#src/components/card-morph.ts";
      </script>
    </Base>
  )
}
