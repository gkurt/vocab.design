---
import Base from '#src/layouts/Base.astro';
import { MACHINE_ROUTES } from '#src/lib/agents.ts';
import { pageUrl } from '#src/lib/url.ts';
---

<Base
  title="Not found · vocab.design"
  description="That page is not in the dictionary. Here are the entries closest to what you asked for."
>
  <meta slot="head" name="robots" content="noindex" />
  <section class="pt-10 pb-12">
    <h1 class="font-serif text-4xl font-semibold tracking-tight text-balance">
      Not in the dictionary.
    </h1>
    <p class="article mt-5 text-muted">
      We could not find that word. Check the spelling, or search the
      dictionary.
    </p>
    <a
      data-search-for
      hidden
      href={pageUrl("/search")}
      class="mt-6 inline-block text-sm underline hover:text-ink"
    >
      Search for it instead &rarr;
    </a>
  </section>

  <section data-suggestions hidden class="mb-12">
    <h2 class="mb-4 text-sm tracking-wide text-muted uppercase">
      Did you mean
    </h2>
    <ul class="grid gap-2"></ul>
  </section>

  <section class="mb-12 text-sm text-muted">
    Or start from <a href={pageUrl("/")} class="underline hover:text-ink"
      >the front page</a
    >, which lists every term by category, by tag and A to Z, or the <a
      href={pageUrl("/glossary")}
      class="underline hover:text-ink">glossary</a
    >, which includes every alias.
  </section>

  {/* The same recovery for a caller that would rather have the list than guess again
      (SPEC §10). A 404 is where an agent lands after building a URL that does not
      exist, and these are the four files that tell it which ones do. */}
  <section class="mb-12 text-sm text-muted">
    <h2 class="mb-3 tracking-wide uppercase">The dictionary as data</h2>
    <ul class="grid gap-1">
      {
        MACHINE_ROUTES.map((route) => (
          <li>
            <a href={pageUrl(route.href)} class="underline hover:text-ink">
              {route.name}
            </a>
            , {route.blurb}.
          </li>
        ))
      }
    </ul>
  </section>

  <script>
    import "#src/components/notfound.ts";
  </script>
</Base>
