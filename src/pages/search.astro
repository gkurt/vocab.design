---
import SearchPanel from '#src/components/SearchPanel.astro';
import Base from '#src/layouts/Base.astro';
import { getTerms } from '#src/lib/terms.ts';

const terms = await getTerms();
const aliasCount = terms.reduce((n, t) => n + t.data.aliases.length, 0);
---

<Base
  title="Search · vocab.design"
  description={`Search ${terms.length} design and UI terms and ${aliasCount} aliases by name, by definition, or by the words in the articles.`}
>
  <section class="pt-10 pb-6">
    <h1 class="font-serif text-4xl font-semibold tracking-tight text-balance">
      Search
    </h1>
    <p class="article mt-5 text-muted">
      Full text over every term: the headword, its aliases, the definition, and the
      article. If you only half know the word, describe the thing instead, because
      the articles are indexed too.
    </p>
  </section>

  <SearchPanel variant="page" />

  <script>
    import "#src/components/SiteSearch.ts";
  </script>
</Base>
