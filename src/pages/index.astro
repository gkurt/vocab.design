---
import Carousel from '#src/components/Carousel.astro';
import Base from '#src/layouts/Base.astro';
import { CATEGORY_BLURBS } from '#src/lib/categories.ts';
import { LETTERS, letterOf } from '#src/lib/glossary.ts';
import { CATEGORIES } from '#src/lib/schema.ts';
import { siteGraph } from '#src/lib/structured-data.ts';
import { facets, isAdvertised } from '#src/lib/tags.ts';
import { getTerms } from '#src/lib/terms.ts';
import { pageUrl } from '#src/lib/url.ts';

const terms = await getTerms();
const published = terms.filter((t) => t.data.status !== 'stub');
const aliasCount = terms.reduce((n, t) => n + t.data.aliases.length, 0);
const populated = facets(terms).filter((f) => f.terms.length > 0);
/**
 * The tags this page names. Every populated tag has a page of its own and filters the
 * search; the broad ones are the ones worth scanning here (SPEC §2.5).
 */
const advertised = populated.filter(isAdvertised);
const byCategory = CATEGORIES.map((category) => ({
  category,
  count: published.filter((t) => t.data.category === category).length,
})).filter((group) => group.count > 0);

/**
 * Every headword, A to Z, in one place. This page IS the directory: there is no /browse
 * above it and no facet index beside it, so the whole vocabulary has to be readable from
 * here in one scroll. Names only, sliced by letter and set in columns, because a list
 * this long is scanned rather than read.
 *
 * Terms only, deliberately. The glossary is the list that carries the aliases too, and
 * repeating 3,888 of them here would bury the words they point at.
 */
const named = published.sort((a, b) => a.data.name.localeCompare(b.data.name, 'en', { sensitivity: 'base' }));
const alphabet = LETTERS.map((letter) => ({
  letter,
  terms: named.filter((t) => letterOf(t.data.name) === letter),
})).filter((group) => group.terms.length > 0);

const stubs = terms.filter((t) => t.data.status === 'stub').sort((a, b) => a.data.name.localeCompare(b.data.name));

/**
 * Said twice, in the meta tag a search engine reads and in the JSON-LD an agent reads, so
 * one string is the only place either can be wrong.
 */
const description =
  'Design and UI terms with live demos, aliases, and the connections between them. Know the word, get the thing, from people and from AI agents.';
---

<Base
  title="vocab.design · a visual dictionary of design & UI vocabulary"
  description={description}
>
  {/* What this site IS, for a crawler or an agent that has landed on the front page
      (SPEC §10): who publishes it, what the whole set is, and where the machine
      readable copies of it are. The front page only: a term page says what one word
      means, and repeating the publisher on all 1,076 of them says nothing new. */}
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(
      siteGraph({ description, termCount: published.length }),
    )}
  />
  <section class="pt-10 pb-12">
    <h1 class="font-serif text-4xl font-semibold tracking-tight text-balance">
      The words interfaces are made of.
    </h1>
    <p class="article mt-5 text-muted">
      A linked dictionary of design and UI vocabulary: every term with a live
      demo. Working with AI agents is mostly about knowing the vocabulary; here
      is where you learn to say exactly what you mean.
    </p>
    <p class="mt-6 text-sm text-muted">
      {published.length} terms · {aliasCount} aliases · {populated.length} tags ·
      a demo on every page
    </p>
  </section>

  <Carousel />

  <section id="by-category" class="mb-12 scroll-mt-24">
    <h2 class="mb-4 text-sm tracking-wide text-muted uppercase">By category</h2>
    <ul class="grid gap-2">
      {
        byCategory.map(({ category, count }) => (
          <li>
            <a
              href={pageUrl(`/browse/${category}`)}
              class="group block rounded-lg border border-line bg-surface px-5 py-4 hover:border-accent"
            >
              <span class="font-serif text-lg font-semibold group-hover:text-accent">
                {category}
              </span>
              <span class="ml-2 text-sm text-muted">{count} terms</span>
              <p class="mt-1 text-sm text-muted">{CATEGORY_BLURBS[category]}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="by-tag" class="mb-12 scroll-mt-24">
    <h2 class="mb-4 text-sm tracking-wide text-muted uppercase">By tag</h2>
    <ul class="flex flex-wrap gap-2">
      {
        advertised.map(({ tag, label, terms: members }) => (
          <li>
            <a
              href={pageUrl(`/tags/${tag}`)}
              class="inline-block rounded-full border border-line px-3 py-1 text-sm text-muted hover:border-accent hover:text-ink"
            >
              {label}
              <span class="ml-1 opacity-60">{members.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-12">
    <div class="mb-2 flex items-baseline gap-2">
      <h2 class="text-sm tracking-wide text-muted uppercase">Every term</h2>
      <span class="text-xs text-muted">{published.length}</span>
    </div>
    <p class="article mb-5 text-sm text-muted">
      The whole vocabulary, A to Z. For aliases, see the <a
        href={pageUrl("/glossary")}
        class="text-accent underline underline-offset-3">glossary</a
      >.
    </p>
    <div class="columns-2 gap-x-6 sm:columns-3">
      {
        alphabet.map(({ letter, terms: group }) => (
          <section class="mb-4">
            <h3
              id={`letter-${letter === "#" ? "other" : letter}`}
              class="mb-1 scroll-mt-24 break-after-avoid font-serif text-sm font-semibold uppercase text-muted"
            >
              {letter}
            </h3>
            <ul>
              {group.map((t) => (
                <li class="leading-6">
                  <a
                    href={pageUrl(t.data.slug)}
                    class="text-sm text-muted hover:text-accent"
                  >
                    {t.data.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  {
    stubs.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-2 text-sm tracking-wide text-muted uppercase">
          In progress
        </h2>
        <p class="article mb-4 text-sm text-muted">
          These terms have a definition. The full article and demo are still to
          come.
        </p>
        <ul class="flex flex-wrap gap-2">
          {stubs.map((t) => (
            <li>
              <a
                href={pageUrl(t.data.slug)}
                class="inline-block rounded-full border border-line px-3 py-1 text-sm text-muted hover:text-ink"
              >
                {t.data.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mb-8 border-t border-line pt-6">
    <h2 class="mb-2 text-sm tracking-wide text-muted uppercase">For agents</h2>
    <p class="article text-sm text-muted">
      The whole dictionary is machine-readable: <a
        href={pageUrl("/terms.json")}
        class="text-accent underline underline-offset-3">terms.json</a
      > carries every term, alias and relation as data, <a
        href={pageUrl("/llms.txt")}
        class="text-accent underline underline-offset-3">llms.txt</a
      > maps the site and <a
        href={pageUrl("/llms-full.txt")}
        class="text-accent underline underline-offset-3">llms-full.txt</a
      > lists every term with its definition, and every term page has a{" "}
      <code class="text-ink">.md</code> twin at <code class="text-ink"
        >/{"{slug}"}.md</code
      >.
    </p>
  </section>

  <p class="text-sm text-muted">
    <a
      href={pageUrl("/search")}
      data-search-open
      class="underline underline-offset-3 hover:text-ink">Search</a
    > · <a
      href={pageUrl("/glossary")}
      class="underline underline-offset-3 hover:text-ink">Glossary</a
    >
  </p>
</Base>
