---
import Base from '#src/layouts/Base.astro';
import { CATEGORY_BLURBS } from '#src/lib/categories.ts';
import { CATEGORIES } from '#src/lib/schema.ts';
import { facets } from '#src/lib/tags.ts';
import { getTerms } from '#src/lib/terms.ts';
import { pageUrl } from '#src/lib/url.ts';

const terms = await getTerms();
const published = terms.filter((t) => t.data.status !== 'stub');
const aliasCount = terms.reduce((n, t) => n + t.data.aliases.length, 0);
const facetCount = facets(terms).filter((f) => f.terms.length > 0).length;
const byCategory = CATEGORIES.map((category) => ({
  category,
  count: published.filter((t) => t.data.category === category).length,
})).filter((group) => group.count > 0);
---

<Base
  title="vocab.design · a visual dictionary of design & UI vocabulary"
  description="Design and UI terms with live specimens, aliases, and the connections between them. Know the word, get the thing, from people and from AI agents."
>
  <section class="pt-10 pb-12">
    <h1 class="font-serif text-4xl font-semibold tracking-tight text-balance">
      The words interfaces are made of.
    </h1>
    <p class="article mt-5 text-muted">
      A linked dictionary of design and UI vocabulary: every term with a live
      specimen, its aliases, and the concepts it contrasts with. Working with AI
      agents is mostly about knowing the vocabulary; here is where you learn to
      say exactly what you mean.
    </p>
    <p class="mt-6 text-sm text-muted">
      {published.length} terms · {aliasCount} aliases · {facetCount} facets · a
      specimen on every page
    </p>
  </section>

  <section class="mb-12">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2 class="text-sm tracking-wide text-muted uppercase">By category</h2>
      <a href={pageUrl("/browse")} class="text-xs text-muted hover:text-ink">
        browse everything &rarr;
      </a>
    </div>
    <ul class="grid gap-2">
      {
        byCategory.map(({ category, count }) => (
          <li>
            <a
              href={pageUrl(`/browse/${category}`)}
              class="group block rounded-lg border border-line bg-surface px-5 py-4 hover:border-accent"
            >
              <span class="font-serif text-lg font-semibold group-hover:text-accent">
                {category}
              </span>
              <span class="ml-2 text-sm text-muted">{count} terms</span>
              <p class="mt-1 text-sm text-muted">
                {CATEGORY_BLURBS[category]}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-sm tracking-wide text-muted uppercase">
      Other ways in
    </h2>
    <ul class="grid gap-2">
      <li>
        <a
          href={pageUrl("/tags")}
          class="group block rounded-lg border border-line bg-surface px-5 py-4 hover:border-accent"
        >
          <span class="font-serif text-lg font-semibold group-hover:text-accent"
            >Facets</span
          >
          <span class="ml-2 text-sm text-muted">{facetCount}</span>
          <p class="mt-1 text-sm text-muted">
            The groupings that cut across categories: forms, touch, scroll,
            theming and the rest.
          </p>
        </a>
      </li>
      <li>
        <a
          href={pageUrl("/search")}
          class="group block rounded-lg border border-line bg-surface px-5 py-4 hover:border-accent"
        >
          <span class="font-serif text-lg font-semibold group-hover:text-accent"
            >Search</span
          >
          <p class="mt-1 text-sm text-muted">
            Full text over every term and article, for when you only half know the
            word and can describe the thing.
          </p>
        </a>
      </li>
      <li>
        <a
          href={pageUrl("/glossary")}
          class="group block rounded-lg border border-line bg-surface px-5 py-4 hover:border-accent"
        >
          <span class="font-serif text-lg font-semibold group-hover:text-accent"
            >Glossary</span
          >
          <span class="ml-2 text-sm text-muted"
            >{published.length + aliasCount}</span
          >
          <p class="mt-1 text-sm text-muted">
            A to Z, every term and every alias, because the alias is usually the
            word you arrived with.
          </p>
        </a>
      </li>
    </ul>
  </section>

  <section class="mb-12 border-t border-line pt-6">
    <h2 class="mb-2 text-sm tracking-wide text-muted uppercase">
      For agents
    </h2>
    <p class="article text-sm text-muted">
      The whole dictionary is machine-readable: <a
        href={pageUrl("/terms.json")}
        class="text-accent underline underline-offset-3">terms.json</a
      > carries every term, alias and relation as data, <a
        href={pageUrl("/llms.txt")}
        class="text-accent underline underline-offset-3">llms.txt</a
      > is the same collection as prose, and every term page has a
      <code class="text-ink">.md</code> twin at <code class="text-ink"
        >/{"{slug}"}.md</code
      >.
    </p>
  </section>
</Base>
