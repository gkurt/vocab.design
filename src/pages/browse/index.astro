---
import Base from '#src/layouts/Base.astro';
import { CATEGORY_BLURBS } from '#src/lib/categories.ts';
import { CATEGORIES } from '#src/lib/schema.ts';
import { getTerms } from '#src/lib/terms.ts';
import { pageUrl } from '#src/lib/url.ts';

const terms = await getTerms();
const published = terms.filter((t) => t.data.status !== 'stub').sort((a, b) => a.data.name.localeCompare(b.data.name));
const stubs = terms.filter((t) => t.data.status === 'stub').sort((a, b) => a.data.name.localeCompare(b.data.name));
const byCategory = CATEGORIES.map((category) => ({
  category,
  terms: published.filter((t) => t.data.category === category),
})).filter((group) => group.terms.length > 0);
---

<Base
  title="Browse · vocab.design"
  description={`All ${published.length} terms, grouped by the nine categories: component, layout, pattern, interaction, motion, typography, color, aesthetic, accessibility.`}
>
  <section class="pt-10 pb-8">
    <h1 class="font-serif text-4xl font-semibold tracking-tight text-balance">
      Browse
    </h1>
    <p class="article mt-5 text-muted">
      Every term by category, names only, so the whole vocabulary fits in one scroll.
      Each category page has the same list with definitions. A term has exactly one
      category, because a term is one kind of thing. For the groupings that cut the other way, see{" "}
      <a
        href={pageUrl("/tags")}
        class="text-accent underline underline-offset-3">the facets</a
      >; for one alphabetical list of every name and alias, see{" "}
      <a
        href={pageUrl("/glossary")}
        class="text-accent underline underline-offset-3">the glossary</a
      >.
    </p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {
        byCategory.map(({ category, terms: group }) => (
          <li>
            <a
              href={pageUrl(`/browse/${category}`)}
              class="inline-block rounded-full border border-line px-3 py-1 text-sm text-muted hover:border-accent hover:text-ink"
            >
              {category}
              <span class="ml-1 opacity-60">{group.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    byCategory.map(({ category, terms: group }) => (
      <section class="mb-10">
        <div class="mb-2 flex items-baseline justify-between gap-4">
          <h2 id={category} class="scroll-mt-6 text-sm tracking-wide text-muted uppercase">
            {category}
          </h2>
          <a
            href={pageUrl(`/browse/${category}`)}
            class="text-xs text-muted hover:text-ink"
          >
            {group.length} terms, with definitions &rarr;
          </a>
        </div>
        <p class="article mb-3 text-sm text-muted">{CATEGORY_BLURBS[category]}</p>
        <ul class="flex flex-wrap gap-x-3 gap-y-1.5">
          {group.map((t) => (
            <li>
              <a
                href={pageUrl(t.data.slug)}
                class="text-sm text-muted hover:text-accent"
              >
                {t.data.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    stubs.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-4 text-sm tracking-wide text-muted uppercase">
          In progress
        </h2>
        <p class="article mb-4 text-sm text-muted">
          These have a definition so links never dead-end. The article and specimen
          are still to come.
        </p>
        <ul class="flex flex-wrap gap-2">
          {stubs.map((t) => (
            <li>
              <a
                href={pageUrl(t.data.slug)}
                class="inline-block rounded-full border border-line px-3 py-1 text-sm text-muted hover:text-ink"
              >
                {t.data.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
