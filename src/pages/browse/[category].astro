---
import Base from '#src/layouts/Base.astro';
import { CATEGORY_BLURBS } from '#src/lib/categories.ts';
import { CATEGORIES, type Category } from '#src/lib/schema.ts';
import { facets } from '#src/lib/tags.ts';
import { getTerms, type TermEntry } from '#src/lib/terms.ts';
import { absoluteUrl, pageUrl } from '#src/lib/url.ts';

interface Props {
  category: Category;
  terms: TermEntry[];
  /**
   * The facets this category reaches into, largest first. A facet holding ONE term of
   * this category is a coincidence rather than a reach, so the line starts at two.
   */
  reach: { tag: string; count: number }[];
}

export async function getStaticPaths() {
  const all = await getTerms();
  const published = all.filter((t) => t.data.status !== 'stub');
  const allFacets = facets(all);
  return CATEGORIES.map((category) => {
    const terms = published.filter((t) => t.data.category === category).sort((a, b) => a.data.name.localeCompare(b.data.name));
    const reach = allFacets
      .map(({ tag, terms: members }) => ({ tag, count: members.filter((t) => t.data.category === category).length }))
      .filter((r) => r.count > 1)
      .sort((a, b) => b.count - a.count);
    return { params: { category }, props: { category, terms, reach } };
  });
}

const { category, terms, reach } = Astro.props;
const others = CATEGORIES.filter((c) => c !== category);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'vocab.design', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Browse', item: absoluteUrl('/browse') },
    { '@type': 'ListItem', position: 3, name: category, item: absoluteUrl(`/browse/${category}`) },
  ],
};
---

<Base
  title={`${category} · vocab.design`}
  description={`${terms.length} ${category} terms. ${CATEGORY_BLURBS[category]}`}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbs)}
  />
  <section class="pt-10 pb-8">
    <p class="text-sm text-muted italic">category</p>
    <h1 class="mt-1 font-serif text-4xl font-semibold tracking-tight">
      {category}
    </h1>
    <p class="article mt-4 text-lg text-muted">{CATEGORY_BLURBS[category]}</p>
    <p class="mt-3 text-sm text-muted">
      {terms.length} terms · <a
        href={pageUrl("/browse")}
        class="text-accent underline underline-offset-3">all categories</a
      >
    </p>
    {
      reach.length > 0 && (
        <p class="mt-4 text-sm text-muted">
          <span class="text-muted">Also filed under: </span>
          {reach.map((r, i) => (
            <>
              {i > 0 && " · "}
              <a href={pageUrl(`/tags/${r.tag}`)} class="hover:text-ink">
                {r.tag}
                <span class="ml-0.5 opacity-60">{r.count}</span>
              </a>
            </>
          ))}
        </p>
      )
    }
  </section>

  <ul class="grid gap-2 pb-12">
    {
      terms.map((t) => (
        <li>
          <a
            href={pageUrl(t.data.slug)}
            class="group block rounded-lg border border-line bg-surface px-5 py-4 hover:border-accent"
          >
            <span class="font-serif text-lg font-semibold group-hover:text-accent">
              {t.data.name}
            </span>
            {t.data.aliases.length > 0 && (
              <span class="ml-2 text-sm text-muted italic">
                also {t.data.aliases.map((a) => a.name).join(", ")}
              </span>
            )}
            <p class="mt-1 text-sm text-muted">{t.data.definition}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <section class="mb-12 border-t border-line pt-6">
    <h2 class="mb-3 text-sm tracking-wide text-muted uppercase">
      Other categories
    </h2>
    <ul class="flex flex-wrap gap-2">
      {
        others.map((c) => (
          <li>
            <a
              href={pageUrl(`/browse/${c}`)}
              class="inline-block rounded-full border border-line px-3 py-1 text-sm text-muted hover:border-accent hover:text-ink"
            >
              {c}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
