---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/source-serif-4';
/**
 * The serif's latin subset, preloaded by URL. Every heading on the site is set in it, so
 * on a term page it draws the LCP element, and the browser cannot know it is wanted until
 * it has parsed the CSS and matched a rule. `?url` hands over the hashed asset the font
 * stylesheet already points at, so this is a hint about a file that was being fetched
 * anyway, not a second copy of it.
 */
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '#src/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '#src/components/Analytics.astro';
import SearchDialog from '#src/components/SearchDialog.astro';
import SpecimenFonts from '#src/components/SpecimenFonts.astro';
import { pageType } from '#src/lib/page-type.ts';
import { canonicalPath, pageUrl } from '#src/lib/url.ts';

interface Props {
  title: string;
  description: string;
  /** Term pages only: analytics groups by category, which is nowhere in the URL. */
  category?: string;
  /**
   * The share image, site-relative (SPEC §10). A term page hands over its own
   * specimen's still; everything else falls through to the site card, because a
   * link preview with no picture is a link preview nobody looks at.
   */
  image?: string;
  /** What the share image shows, for a reader whose client reads the alt out. */
  imageAlt?: string;
}

const { title, description, category, image, imageAlt } = Astro.props;
const path = canonicalPath(Astro.url.pathname);
/**
 * What kind of page this is, and which category a term belongs to, stated on the root
 * element (SPEC §10). Analytics needs both on every page and neither is in the URL, and
 * under the router a swapped page's parameters cannot ride in a script: the head's tag
 * bootstrap has to be byte-identical on every page so the router runs it exactly once.
 * The root is the one element whose server-rendered attributes are replaced by each
 * swap, so this is the place both the head script and `analytics.ts` can read them from.
 */
const kind = pageType(path, import.meta.env.BASE_URL);
const canonical = new URL(path, Astro.site);
// Crawlers resolve neither a relative image nor a protocol-relative one, so this is the
// one place on the site that must name the absolute URL of an asset.
const shareImage = new URL(pageUrl(image ?? '/og/site.png'), Astro.site);
const shareAlt = imageAlt ?? 'vocab.design: a linked dictionary of design and UI vocabulary, with a live demo on every page.';
// /search is the search, so it gets no modal: the nav link there is just a link to here.
const onSearchPage = path.endsWith('/search');
---

<!doctype html>
<html lang="en" data-page-type={kind} data-term-category={category}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={serifLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* The icon set (SPEC §10). The ICO is first and the SVG second on purpose: a
        browser that understands neither `sizes` nor SVG takes the ICO, every modern one
        walks on to the SVG, and Safari takes the Apple icon for a home screen. The ICO
        also answers the request a browser makes for `/favicon.ico` before it has parsed
        a byte of this document, which on a static host is otherwise served the 404 page. */}
    <link rel="icon" href={pageUrl("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={pageUrl("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={pageUrl("/apple-touch-icon.png")} />
    <SpecimenFonts />
    {/* The colour a mobile browser paints its own chrome. Media-scoped rather than
        scripted, so it is right for a reader with no JavaScript; the toggle re-states
        both when a reader has overridden their system theme. */}
    <meta
      name="theme-color"
      content="#faf9f6"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#171512"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* A term is a document about one word, so it is an article; every listing and tool
        page is the site talking about itself. Derived from whether a category came in
        rather than from a second prop that could disagree with the first. */}
    <meta property="og:type" content={category ? "article" : "website"} />
    <meta property="og:site_name" content="vocab.design" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={pageUrl("/sitemap-index.xml")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="vocab.design: new entries"
      href={pageUrl("/rss.xml")}
    />
    <Analytics />
    {/* Client-side navigation (SPEC §3). Every page that carries the chrome carries the
        router, and the two documents that do not (the random redirect, and a specimen's
        own frame) are left to the browser, which is what the router does when the page it
        fetched does not have it. */}
    <ClientRouter />
    <script is:inline>
      // The reader's own answers to two questions the server could not have known, both
      // written on the root element. Classic and inline, so they are settled during parse
      // and the first paint is already right.
      //
      // Under the router the root's attributes are REPLACED by each swap: everything the
      // server rendered comes back with the new page, and everything set here is wiped.
      // So this is a function, and the swap calls it again. `astro:after-swap` is the one
      // moment that works, because it runs inside the transition's own DOM update, before
      // the new page is captured for the animation; anything later is a flash of the
      // wrong theme on every navigation. It is also why nothing here re-runs on
      // `astro:page-load`, and why the script is identical on every page: the router
      // recognises a script it has already executed and leaves this one alone.
      function vdRoot() {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark")
          document.documentElement.dataset.theme = theme;
        // Which modifier the search chord is spelled with. Set here rather than in the
        // deferred script so the header paints the right key once: both spellings are
        // real text in the markup and CSS hides the wrong one, so there is nothing to
        // reflow.
        document.documentElement.dataset.chord = /mac|iphone|ipad|ipod/i.test(
          navigator.platform || navigator.userAgent,
        )
          ? "apple"
          : "other";
      }
      vdRoot();
      document.addEventListener("astro:after-swap", vdRoot);
    </script>
    <slot name="head" />
  </head>
  <body>
    {/* The chrome's one piece of furniture, and it stays out of the way: transparent and
        borderless while the page is at rest, solid with a hairline under it the moment
        anything has scrolled beneath. The sentinel above it is what answers "has it": a
        few pixels pinned to the top of the document, whose leaving the viewport IS the
        header being stuck. It takes no room, because it is out of flow. */}
    <div class="vd-header-sentinel" aria-hidden="true"></div>
    {/* Named, and not animated. A named element is lifted out of the page's own snapshot
        and matched with its counterpart on the next page: this one sits at the same place
        on every page, so there is nothing to animate, and without the name it would be
        part of the cross-fade and the furniture would blink on every navigation. Not
        `transition:persist`, which would carry the OLD header across: `aria-current` on
        the search link is per-page, and stale state there is a lie to a screen reader. */}
    <div
      data-header
      transition:name="chrome-header"
      transition:animate="none"
      class="sticky top-0 z-40"
    >
      <header
        class="vd-header-bar mx-auto flex max-w-3xl items-baseline justify-between gap-4 px-5 py-4"
      >
        <a
          href={pageUrl("/")}
          class="vd-wordmark min-w-0 font-serif font-semibold tracking-tight"
          >vocab.design</a
        >
        <nav
          class="vd-nav flex shrink-0 items-center gap-3 text-sm text-muted sm:gap-5"
        >
          <a href={pageUrl("/glossary")} data-nav class="hover:text-ink"
            >A&ndash;Z</a
          >
          {/* Not prefetched and not a canonical document: it answers with a different
              term every time, so there is nothing to prefetch and nothing to index. And
              not client-side either: the page it names is a redirect that replaces itself,
              so the router would fetch a document it must then throw away. `reload` hands
              the click straight back to the browser. */}
          <a
            href={pageUrl("/random")}
            data-nav
            data-astro-reload
            data-astro-prefetch="false"
            class="hover:text-ink">Random</a
          >
          <a
            href={pageUrl("/search")}
            data-search-open={onSearchPage ? undefined : true}
            aria-current={onSearchPage ? "page" : undefined}
            class="group inline-flex items-baseline gap-1.5 hover:text-ink"
          >
            Search
            <kbd class="vd-chord">
              <span class="vd-chord-apple">&#8984;</span><span
                class="vd-chord-other">Ctrl&nbsp;</span
              >K
            </kbd>
          </a>
          {/* Icon-only, so each carries its own accessible name and the drawing is
              hidden from the accessibility tree. `me` states that the profile and the
              repository are the same author as this site. */}
          <a
            href="https://x.com/gkurttech"
            rel="me noopener"
            aria-label="The author on X"
            title="The author on X"
            data-nav
            class="vd-icon-link hover:text-ink"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/gkurt/vocab.design"
            rel="me noopener"
            aria-label="This site's source on GitHub"
            title="This site's source on GitHub"
            data-nav
            class="vd-icon-link hover:text-ink"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A7.995 7.995 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
          </a>
          <button
            data-theme-toggle
            class="cursor-pointer hover:text-ink"
            title="Toggle theme">◐</button
          >
        </nav>
      </header>
    </div>
    <main class="mx-auto max-w-3xl px-5 pt-6 pb-24">
      <slot />
    </main>
    {!onSearchPage && <SearchDialog />}
    <script>
      import "#src/components/analytics.ts";
      import { onPage } from "#src/lib/on-page.ts";

      // The chrome's own wiring, and every line of it is per-page: the sentinel, the
      // metas and the toggle all arrive again with each swapped document, so a reference
      // taken once would be to the first page's furniture for the rest of the visit.
      onPage((signal) => {
        // Solid-when-stickied, from the one fact CSS cannot ask for on its own: whether
        // anything has scrolled past. An observer on the sentinel rather than a scroll
        // listener, because the question is about layout and the observer answers it from
        // layout: it is right however the page got where it is, a reader's wheel, a
        // restored position, an anchor, or a reflow that moved the ground underneath.
        const header = document.querySelector("[data-header]");
        const sentinel = document.querySelector(".vd-header-sentinel");
        // Two small care points, both about the shape of the API rather than about this
        // header: one delivery can carry several records for the same target, and only
        // the newest describes where the page is now; and the observer is held in a
        // variable, because an unreferenced one may be collected out from under its own
        // observation.
        const stuck = new IntersectionObserver((entries) => {
          const latest = entries.at(-1);
          if (latest)
            header?.toggleAttribute("data-stuck", !latest.isIntersecting);
        });
        if (header && sentinel) stuck.observe(sentinel);
        signal.addEventListener("abort", () => stuck.disconnect());

        // The theme-color metas are scoped to the system preference, which is the right
        // answer until a reader overrides it here. Then both are re-stated with the
        // chosen scheme's paper, so the browser's own chrome follows the page rather than
        // the OS. The values are global.css's --vd-paper; there is no way to ask CSS for
        // a token from a media query that does not apply. Re-stated per page because the
        // metas are the incoming document's, media-scoped and fresh.
        const TINT = { light: "#faf9f6", dark: "#171512" };
        const tint = (theme: "light" | "dark") => {
          for (const meta of document.querySelectorAll<HTMLMetaElement>(
            'meta[name="theme-color"]',
          ))
            meta.content = TINT[theme];
        };
        const chosen = document.documentElement.dataset.theme;
        if (chosen === "light" || chosen === "dark") tint(chosen);

        document.querySelector("[data-theme-toggle]")?.addEventListener(
          "click",
          () => {
            const root = document.documentElement;
            const dark = matchMedia("(prefers-color-scheme: dark)").matches;
            const now = root.dataset.theme ?? (dark ? "dark" : "light");
            const next = now === "dark" ? "light" : "dark";
            root.dataset.theme = next;
            localStorage.setItem("theme", next);
            tint(next);
          },
          { signal },
        );
      });
    </script>
  </body>
</html>
