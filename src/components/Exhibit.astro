---
import SpecimenStage from '#src/components/SpecimenStage.astro';
import { type Exhibit, exhibitOfDay, exhibits } from '#src/lib/exhibit.ts';
import { getTerms } from '#src/lib/terms.ts';
import { pageUrl } from '#src/lib/url.ts';

/**
 * The front page's window (SPEC §3): ONE specimen, from the pool of demonstrations
 * curated with `exhibit: true`, rotated on every reload.
 *
 * One, not a strip, for a reason the stage itself imposes: a page's scheduler grants
 * attract to a single stage at a time (SPEC §7), so a band of three would be one
 * specimen playing above two holding still, which reads as two broken ones. And a
 * specimen is authored at the full column width, so shrinking it to fit three across
 * would keep the geometry and lose the type.
 *
 * The rotation is a script rather than a build-time pick because the site is static:
 * every reader is served the same HTML. So the whole pool is serialized here, the built
 * page carries the day's specimen (a reader with no JavaScript still gets one, and it
 * moves with the deploy), and the script swaps in a different one before the stage
 * upgrades. The swap is not a transition: it happens during parse, so nothing renders
 * twice and no stage is ever mounted and thrown away.
 */
const pool: Exhibit[] = exhibits(await getTerms());

/** Links are resolved at build time, never assembled in the script from a base (SPEC §10). */
const cards = pool.map((e) => ({ ...e, href: pageUrl(e.slug), categoryHref: pageUrl(`/browse/${e.category}`) }));
const shown = exhibitOfDay(cards, Math.floor(Date.now() / 86_400_000));
---

{
  shown && (
    <section class="mb-12" data-exhibit>
      <h2 class="mb-4 text-sm tracking-wide text-muted uppercase">A specimen</h2>
      <SpecimenStage slug={shown.slug} name={shown.name} isolation={shown.demo} />
      <p class="mt-3">
        <a
          href={shown.href}
          data-exhibit-link
          class="font-serif text-lg font-semibold text-accent underline underline-offset-3"
        >
          {shown.name}
        </a>
        <a
          href={shown.categoryHref}
          data-exhibit-category
          class="ml-2 text-sm text-muted hover:text-ink"
        >
          {shown.category}
        </a>
      </p>
      <p class="article mt-1 text-sm text-muted" data-exhibit-definition>
        {shown.definition}
      </p>
      {cards.length > 1 && (
        <p class="mt-2 text-xs text-muted" data-exhibit-hint hidden>
          One of {cards.length} specimens shown here. Reload for another.
        </p>
      )}

      {/* Classic and inline, so it runs during parse: the stage's own script is a module
          and therefore deferred, which is what makes it safe to rewrite the element's
          attributes here and have <vd-stage> read the new ones when it upgrades. */}
      <script is:inline define:vars={{ exhibitPool: cards }}>
        (function () {
          if (exhibitPool.length < 2) return;
          var root = document.querySelector('[data-exhibit]');
          if (!root) return;
          var KEY = 'vd:exhibit';
          var last = null;
          // Private modes throw on storage. A repeated specimen is not worth an exception.
          try {
            last = sessionStorage.getItem(KEY);
          } catch {}
          // Never twice running: the reader reloading to see another one gets another one.
          var choices = exhibitPool.filter(function (e) {
            return e.slug !== last;
          });
          var pick = choices[Math.floor(Math.random() * choices.length)];
          try {
            sessionStorage.setItem(KEY, pick.slug);
          } catch {}

          var set = function (selector, text, href) {
            var el = root.querySelector(selector);
            if (!el) return;
            el.textContent = text;
            if (href) el.setAttribute('href', href);
          };
          var stage = root.querySelector('vd-stage');
          if (stage) {
            stage.dataset.slug = pick.slug;
            stage.dataset.name = pick.name;
            stage.dataset.isolation = pick.demo;
            var identify = stage.querySelector('[data-stage-identify]');
            // The stage builds its pin from data-name; this title is the other place the
            // headword is printed, and a stale one names the specimen before last.
            if (identify) identify.title = 'Point out the ' + pick.name.toLowerCase();
          }
          set('[data-exhibit-link]', pick.name, pick.href);
          set('[data-exhibit-category]', pick.category, pick.categoryHref);
          set('[data-exhibit-definition]', pick.definition);
          // Only true once the swap has actually happened: with no script, the built page
          // holds one specimen until the next deploy, and it must not promise otherwise.
          var hint = root.querySelector('[data-exhibit-hint]');
          if (hint) hint.hidden = false;
        })();
      </script>
    </section>
  )
}
