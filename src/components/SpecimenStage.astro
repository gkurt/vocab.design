---
import '#src/styles/stage.css';

interface Props {
  slug: string;
  name: string;
}

const { slug, name } = Astro.props;
---

<vd-stage data-slug={slug} data-name={name} data-state="idle">
  <figure>
    <div class="vd-stage-body">
      <div data-stage-canvas></div>
      <div data-stage-overlay aria-hidden="true"></div>
    </div>
    <figcaption>
      <span>Specimen · {name} — illustrates the concept; for production use, see implementations below.</span>
      <span class="vd-stage-controls">
        <button data-stage-identify type="button" title={`Point out the ${name.toLowerCase()}`}>⌖ Identify</button>
        <button data-stage-replay type="button" title="Replay">↻ Replay</button>
        <button data-stage-theme type="button" title="Toggle specimen theme">◐</button>
      </span>
    </figcaption>
  </figure>
</vd-stage>

<script>
  import '#src/stage/specimen-stage.ts';
</script>
