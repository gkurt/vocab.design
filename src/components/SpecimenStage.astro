---
import '#src/styles/stage.css';

interface Props {
  slug: string;
  name: string;
  /** Isolation mode (SPEC §6): a shadow root, or a specimen document of its own. */
  isolation: 'inline' | 'iframe';
  /**
   * Shot rather than read (SPEC §10): the stage on a capture page, which holds the
   * pose for a camera. No control bar, because nothing on a still can be pressed.
   */
  capture?: boolean;
}

const { slug, name, isolation, capture } = Astro.props;
---

<vd-stage
  data-slug={slug}
  data-name={name}
  data-isolation={isolation}
  data-state="idle"
  data-capture={capture ? "" : undefined}
>
  <figure>
    {/* The overlay wraps the specimen AND the strip below it, because the ghost cursor is
        drawn in overlay coordinates and has to be able to travel down onto the strip's
        controls. Everything the overlay draws is measured against its own box, so widening
        it changes no arithmetic. */}
    <div class="vd-stage-reach">
      <div class="vd-stage-body">
        <div data-stage-canvas></div>
      </div>
      {/* The exhibit's own row: what the specimen says, what the state amounts to, and the
          mode switch. It sits above the control bar and inside the cursor's reach, so it
          belongs to the demonstration rather than to the chrome that frames it. Hidden until
          something fills it, so a specimen with nothing to say gets no empty row.

          A capture keeps the row for its CONTENT lanes only (SPEC §10). Without it the still
          photographs the layout the strip replaced, since the sources are hidden by the same
          pass that draws their mirrors; with the switch in it, a picture nobody can click
          would carry a control. */}
      <div class="vd-stage-strip" data-stage-strip hidden />
      <div data-stage-overlay aria-hidden="true" />
    </div>
    {
      !capture && (
        <div class="vd-stage-bar">
          <span class="vd-stage-controls">
            <button data-stage-identify type="button" title={`Point out the ${name.toLowerCase()}`}>⌖ Identify</button>
          </span>
          <button data-stage-replay type="button" title="Play the demonstration">
            <span class="vd-stage-autoplay">
              <svg viewBox="0 0 10 10" width="9" height="9" aria-hidden="true"
                ><rect x="1.4" y="1" width="2.6" height="8" rx="0.7"></rect><rect x="6" y="1" width="2.6" height="8" rx="0.7"></rect></svg
              >Playing
            </span>
            <span class="vd-stage-play">
              <svg viewBox="0 0 10 10" width="9" height="9" aria-hidden="true"><path d="M2.2 1.1 8.5 5 2.2 8.9Z"></path></svg>Play
            </span>
          </button>
        </div>
      )
    }
  </figure>
</vd-stage>

<script>
  import '#src/stage/specimen-stage.ts';
</script>
