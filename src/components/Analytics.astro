---
/**
 * Google Analytics, loaded only when a measurement ID was baked in at build time
 * (`PUBLIC_GA_ID`). That variable IS the gate: no ID means not a single byte of this
 * ships, which is what makes dev, CI and forks silent, and setting it is a deliberate act
 * by whoever ran the build. So a local build carrying an ID measures, on purpose, which
 * is how the event wiring gets checked without deploying.
 *
 * The tag is injected by script rather than written as a `<script src>` so the reader's
 * refusals are checked BEFORE anything is fetched: Global Privacy Control and Do Not
 * Track, which are a person's decision and are never waivable. `window.gtag` therefore
 * exists only when we are really measuring, and `track()` in `#src/lib/track.ts` no-ops
 * off exactly that.
 *
 * Local hits carry `debug_mode`, so they arrive in GA's DebugView labelled as somebody
 * testing instead of looking like traffic. That is a label, not a gate.
 *
 * `page_type` and `term_category` ride along on every event, because the URL alone cannot
 * say what kind of page it is (terms live at the root) and never says which category a
 * term belongs to. They are READ FROM THE ROOT ELEMENT rather than baked in here, which
 * is what makes this script byte-identical on every page of the site: under client-side
 * navigation the router runs a script it recognises exactly once, so a bootstrap whose
 * text varied per page would run again on some navigations and not others, and each of
 * those runs would append a second tag and send a second page_view. The one page_view a
 * swap DOES need is sent deliberately, from `analytics.ts`.
 */
const id = import.meta.env.PUBLIC_GA_ID;
---

{
  id && (
    <script define:vars={{ id }}>
      (function () {
        var nav = navigator;
        if (nav.globalPrivacyControl === true) return;
        if (nav.doNotTrack === "1" || window.doNotTrack === "1") return;
        var data = document.documentElement.dataset;
        var params = { page_type: data.pageType, term_category: data.termCategory || "" };
        var host = location.hostname;
        if (host === "localhost" || host === "127.0.0.1" || host === "[::1]" || host.endsWith(".local")) params.debug_mode = true;
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag("js", new Date());
        gtag("config", id, params);
        var tag = document.createElement("script");
        tag.async = true;
        tag.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(id);
        document.head.appendChild(tag);
      })();
    </script>
  )
}
