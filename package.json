{
  "name": "vocab.design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A linked visual dictionary of design and UI vocabulary: every term with a live specimen, its aliases, and the connections between them.",
  "homepage": "https://vocab.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/vocab.design.git"
  },
  "bugs": {
    "url": "https://github.com/gkurt/vocab.design/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://github.com/gkurt"
  },
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "typecheck": "astro sync && tsc",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "fix": "biome check --write",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:new": "bun scripts/e2e-new.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "validate": "bun scripts/validate-terms.ts",
    "checks": "bun check && bun typecheck && bun run test && bun validate && bun run test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "cookie": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
